---
// Figma node 52:411
const pillars = [
  { icon: '/icons/live.svg', w: 22, h: 20, title: 'Live in it', text: 'Make it your personal residence.' },
  { icon: '/icons/rent.svg', w: 22, h: 22, title: 'Rent it', text: 'Explore rental income opportunities after completion.' },
  { icon: '/icons/hold.svg', w: 20, h: 20, title: 'Hold it', text: 'Include it in your long-term property portfolio.' },
  {
    icon: '/icons/resell.svg',
    w: 20,
    h: 12,
    title: 'Resell it',
    text: 'Consider future resale opportunities depending on market conditions.',
  },
];
---

<section class="inv" id="investment">
  <div class="container">
    <header class="inv__head">
      <p class="eyebrow">The investment angle</p>
      <h2 class="h2">Your property should have a purpose beyond today.</h2>
      <p class="inv__lede">
        What if the apartment you purchase today becomes part of the assets you build for tomorrow? With Capital
        Heights, you can explore different ownership goals.
      </p>
    </header>

    <ul class="pillars">
      {
        pillars.map((p) => (
          <li class="pillar">
            <span class="pillar__icon">
              <img src={p.icon} width={p.w} height={p.h} alt="" />
            </span>
            <h3 class="pillar__title">{p.title}</h3>
            <p class="pillar__text">{p.text}</p>
          </li>
        ))
      }
    </ul>

    <div class="closing" id="contact">
      <p class="closing__text">
        Whether you're a first-time property buyer, an established professional, an investor or a Nigerian in the
        diaspora, Capital Heights is worth exploring.
      </p>
      <a class="btn btn--lg closing__btn" href="#contact" data-lead>Let's discuss the opportunity</a>
    </div>
  </div>
</section>

<style>
  .inv {
    background: var(--bg-deep);
    padding: 96px 0;
  }
  .inv__head {
    max-width: 768px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
  }
  .inv__lede {
    padding-top: 12px;
    font: 400 18px/28px var(--sans);
    color: var(--muted);
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin-top: 64px;
  }
  .pillar {
    min-height: 274px;
    padding: 40px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    border-radius: 16px;
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }
  .pillar__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 8px;
    background: var(--surface-3);
  }
  .pillar__title {
    padding-top: 12px;
    font: 600 22px/30px var(--serif);
    text-transform: uppercase;
    color: var(--gold);
  }
  .pillar__text { font: 400 16px/24px var(--sans); color: var(--muted); }

  .closing {
    margin-top: 64px;
    padding: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    border-radius: 16px;
    background: linear-gradient(166.9deg, #242b32 0%, #192028 50%, #151c24 100%);
    filter: drop-shadow(0 20px 30px rgba(0, 0, 0, 0.7));
  }
  .closing__text {
    max-width: 672px;
    font: 600 28px/35px var(--serif);
    color: var(--text);
  }
  .closing__btn {
    flex: none;
    padding: 16px 64px;
    margin-bottom: 22px;
    filter: drop-shadow(0 0 17.5px rgba(229, 169, 60, 0.4));
  }

  @media (max-width: 1100px) {
    .pillars { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pillar { min-height: 0; }
  }
  @media (max-width: 900px) {
    .closing { flex-direction: column; align-items: flex-start; padding: 48px 40px; }
    .closing__btn { margin-bottom: 0; }
  }
  @media (max-width: 640px) {
    .inv { padding: 64px 0; }
    .inv__lede { font-size: 16px; line-height: 26px; }
    .pillars { grid-template-columns: 1fr; gap: 16px; margin-top: 40px; }
    .pillar { padding: 28px 24px; }
    .closing { margin-top: 40px; padding: 32px 20px; gap: 24px; }
    .closing__text { font-size: 21px; line-height: 29px; }
    .closing__btn { width: 100%; padding-inline: 16px; }
  }
</style>
