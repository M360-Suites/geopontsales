---
// Figma node 53:1152
const message = 'What if ₦7 million could get you closer to your dream home in Lekki?';
const copies = 5; // enough to overfill very wide screens
---

<header class="header">
  <div class="announce">
    <img class="announce__icon" src="/icons/announce.svg" width="13.333" height="10.667" alt="" />
    <div class="marquee">
      <p class="sr-only">{message}</p>
      <div class="marquee__track" aria-hidden="true">
        {
          [0, 1].map(() => (
            <div class="marquee__group">
              {Array.from({ length: copies }, () => (
                <span class="marquee__item">{message}</span>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <div class="bar">
    <a class="brand" href="#top" aria-label="Capital Heights by Geoponts Properties — home">
      <img
        class="brand__logo"
        src="/images/geopont-logo-light.png"
        width="367"
        height="299"
        alt="Geoponts Properties Ltd"
      />
      <span class="brand__rule" aria-hidden="true"></span>
      <span class="brand__name">CAPITAL HEIGHTS</span>
      <span class="brand__tag">
        <span class="pipe" aria-hidden="true">|</span>
        Waterfront Apartments
        <span class="pipe" aria-hidden="true">|</span>
        Sangotedo
      </span>
    </a>
    <a class="btn cta" href="#offer" data-lead>
      <span class="cta__full">Explore the ₦7M opportunity</span>
      <span class="cta__short">₦7M offer</span>
    </a>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    background: #080f16;
    box-shadow: 0 1px 8px rgba(0, 0, 0, 0.4);
  }
  .announce {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 40px 5px;
    background: #242b32;
    border-bottom: 1px solid #282f36;
  }
  .announce__icon { flex: none; }

  /* Marquee: two identical groups slide left by one group width, then loop seamlessly */
  .marquee {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 24px, #000 calc(100% - 24px), transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, #000 24px, #000 calc(100% - 24px), transparent 100%);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 60s linear infinite;
  }
  .marquee:hover .marquee__track { animation-play-state: paused; }
  .marquee__group { display: flex; flex: none; }
  .marquee__item {
    display: inline-flex;
    align-items: center;
    font: 700 10px/14px var(--sans);
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--gold);
    white-space: nowrap;
  }
  .marquee__item::after {
    content: '•';
    margin-inline: 24px;
    color: var(--gold-btn);
  }
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee__track { animation: none; }
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .bar {
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-inline: var(--gutter);
    max-width: 1360px;
    margin: 0 auto;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }
  .brand__logo {
    height: 48px;
    width: auto;
    flex: none;
  }
  .brand__rule {
    width: 1px;
    height: 32px;
    margin-inline: 8px;
    background: #614d25;
    flex: none;
  }
  .brand__name {
    font: 600 22px/30px var(--serif);
    letter-spacing: 1.1px;
    color: var(--gold);
    white-space: nowrap;
  }
  .brand__tag {
    display: flex;
    align-items: center;
    gap: 8px;
    font: 700 10px/14px var(--sans);
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }
  .pipe {
    font-weight: 600;
    letter-spacing: 1.2px;
    color: var(--gold-btn);
  }
  .cta {
    padding: 8px 16px;
    flex: none;
    box-shadow: 0 0 30px -5px rgba(229, 169, 60, 0.25);
    white-space: nowrap;
  }
  .cta__short { display: none; }

  @media (max-width: 1100px) {
    .brand__tag { display: none; }
  }
  @media (max-width: 640px) {
    .announce { padding-inline: 16px; }
    .marquee__item { font-size: 9px; letter-spacing: 0.6px; }
    .bar { height: 64px; }
    .brand__logo { height: 38px; }
    .brand__rule { height: 24px; margin-inline: 2px; }
    .brand__name { font-size: 16px; line-height: 22px; letter-spacing: 0.6px; }
    .cta { padding: 8px 12px; font-size: 11px; }
    .cta__full { display: none; }
    .cta__short { display: inline; }
  }
  @media (max-width: 360px) {
    .brand__name { font-size: 14px; }
  }
</style>
