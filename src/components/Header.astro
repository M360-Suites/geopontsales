---
// Figma node 53:1152
---

<header class="header">
  <div class="announce">
    <img src="/icons/announce.svg" width="13.333" height="10.667" alt="" />
    <p>What if ₦7 million could get you closer to your dream home in Lekki?</p>
  </div>
  <div class="bar">
    <a class="brand" href="#top" aria-label="Capital Heights by Geoponts Properties — home">
      <img
        class="brand__logo"
        src="/images/geopont-logo-light.png"
        width="367"
        height="299"
        alt="Geoponts Properties Ltd"
      />
      <span class="brand__rule" aria-hidden="true"></span>
      <span class="brand__name">CAPITAL HEIGHTS</span>
      <span class="brand__tag">
        <span class="pipe" aria-hidden="true">|</span>
        Waterfront Apartments
        <span class="pipe" aria-hidden="true">|</span>
        Sangotedo
      </span>
    </a>
    <a class="btn cta" href="#offer">
      <span class="cta__full">Explore the ₦7M opportunity</span>
      <span class="cta__short">₦7M offer</span>
    </a>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    background: rgba(8, 15, 22, 0.8);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow: 0 1px 8px rgba(0, 0, 0, 0.4);
  }
  .announce {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 4px 40px 5px;
    background: rgba(36, 43, 50, 0.9);
    border-bottom: 1px solid rgba(46, 53, 61, 0.4);
  }
  .announce img { flex: none; }
  .announce p {
    font: 700 10px/14px var(--sans);
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--gold);
    text-align: center;
  }
  .bar {
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-inline: var(--gutter);
    max-width: 1360px;
    margin: 0 auto;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }
  .brand__logo {
    height: 48px;
    width: auto;
    flex: none;
  }
  .brand__rule {
    width: 1px;
    height: 32px;
    margin-inline: 8px;
    background: rgba(229, 169, 60, 0.4);
    flex: none;
  }
  .brand__name {
    font: 600 22px/30px var(--serif);
    letter-spacing: 1.1px;
    color: var(--gold);
    white-space: nowrap;
  }
  .brand__tag {
    display: flex;
    align-items: center;
    gap: 8px;
    font: 700 10px/14px var(--sans);
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }
  .pipe {
    font-weight: 600;
    letter-spacing: 1.2px;
    color: var(--gold-btn);
  }
  .cta {
    padding: 8px 16px;
    flex: none;
    box-shadow: 0 0 30px -5px rgba(229, 169, 60, 0.25);
    white-space: nowrap;
  }
  .cta__short { display: none; }

  @media (max-width: 1100px) {
    .brand__tag { display: none; }
  }
  @media (max-width: 640px) {
    .announce { padding-inline: 16px; }
    .announce p { font-size: 9px; letter-spacing: 0.6px; }
    .bar { height: 64px; }
    .brand__logo { height: 38px; }
    .brand__rule { height: 24px; margin-inline: 2px; }
    .brand__name { font-size: 16px; line-height: 22px; letter-spacing: 0.6px; }
    .cta { padding: 8px 12px; font-size: 11px; }
    .cta__full { display: none; }
    .cta__short { display: inline; }
  }
  @media (max-width: 360px) {
    .brand__name { font-size: 14px; }
  }
</style>
