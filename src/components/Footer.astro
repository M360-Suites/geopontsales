---
// Figma node 52:488
const nav = [
  ['Overview', '#top'],
  ['Architectural Story', '#story'],
  ['Residence Configurations', '#offer'],
  ['Waterfront Lifestyle & Amenities', '#lifestyle'],
  ['Lekki-Epe Strategic Corridor', '#location'],
  ['₦7M Milestone Allocation', '#offer'],
];
---

<footer class="footer">
  <div class="container">
    <div class="cols">
      <div class="about">
        <a href="https://geopontsproperties.com/" class="geo" aria-label="Geoponts Properties Ltd">
          <img src="/images/geopont-logo-light.png" width="367" height="299" alt="Geoponts Properties Ltd" loading="lazy" />
        </a>
        <div>
          <p class="name">CAPITAL HEIGHTS</p>
          <p class="eyebrow tagline">Waterfront Apartments | Sangotedo</p>
        </div>
        <p class="blurb">
          An elite architectural masterwork engineered by Geopoints. Prime waterfront residences delivering enduring
          wealth preservation, Atlantic serenity, and premier connectivity along the Lekki-Epe corridor.
        </p>
        <div class="chips">
          <span class="chip chip--gold">Developed by Geopoints</span>
          <span class="chip">Lekki, Lagos</span>
        </div>
      </div>

      <nav class="links" aria-label="Footer">
        <p class="col-title">Direct Navigation</p>
        <ul>
          {nav.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
        </ul>
      </nav>

      <div class="contact">
        <p class="col-title">Executive Advisory &amp; Concierge</p>
        <p class="text">
          For confidential acquisition schedules, title verification dossiers, and private site inspections in Sangotedo:
        </p>
        <address>
          <strong>Geopoints Private Client Office</strong>
          <span>Lekki Peninsula Scheme II, Sangotedo, Lagos</span>
          <a class="gold" href="mailto:invest@capitalheights-geopoints.ng">invest@capitalheights-geopoints.ng</a>
          <a href="tel:+2348002274825">+234 (0) 800 227 4825</a>
        </address>
      </div>
    </div>

    <div class="bottom">
      <p>© 2025 Capital Heights Waterfront Apartments by Geopoints. All rights reserved.</p>
      <ul class="legal">
        <li><a href="#">Privacy Policy</a></li>
        <li><a href="#">Investor Disclosures</a></li>
        <li><a href="#">Terms of Allocation</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-deep);
    padding: 64px 0;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 40px;
    padding-bottom: 40px;
  }
  .about {
    grid-column: 1 / span 5;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .geo img { height: 64px; width: auto; }
  .name {
    font: 600 22px/30px var(--serif);
    letter-spacing: 1.1px;
    color: var(--gold);
  }
  .tagline { color: var(--muted); }
  .blurb {
    max-width: 448px;
    font: 400 14px/20px var(--sans);
    color: var(--muted);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 8px;
  }
  .chip {
    padding: 4px 8px;
    border-radius: 2px;
    background: var(--surface-2);
    font: 700 10px/14px var(--sans);
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--muted);
  }
  .chip--gold { color: var(--gold); }

  .col-title {
    font: 600 12px/16px var(--sans);
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--gold);
  }
  .links {
    grid-column: 6 / span 3;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .links ul {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .links a,
  .text,
  address {
    font: 400 14px/20px var(--sans);
    color: var(--muted);
  }
  .links a:hover,
  address a:hover { color: var(--gold); }

  .contact {
    grid-column: 9 / span 4;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  address {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-style: normal;
  }
  address strong { font-weight: 600; color: var(--text); }
  address .gold { color: var(--gold); overflow-wrap: anywhere; }

  .bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 16px;
  }
  .bottom p { font: 400 14px/20px var(--sans); color: var(--muted); }
  .legal {
    display: flex;
    gap: 16px;
  }
  .legal a {
    font: 700 10px/14px var(--sans);
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 1024px) {
    .cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .about { grid-column: 1 / -1; }
    .links,
    .contact { grid-column: auto; }
    .bottom { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 640px) {
    .footer { padding: 48px 0; }
    .cols { grid-template-columns: 1fr; gap: 32px; }
    .legal { flex-wrap: wrap; gap: 12px 16px; }
  }
</style>
