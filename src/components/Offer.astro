---
// Figma node 52:223 (rebuilt from node metadata; assets exported via Figma API)
const options = [
  {
    badge: 'Option 01',
    img: '/images/evening-dusk.jpg',
    alt: 'Option 1: One-bedroom waterfront apartment render showcasing modern architecture',
    title: '1-Bedroom Waterfront Apartment',
    total: '₦65,000,000',
  },
  {
    badge: 'Option 02 • High capital gain',
    img: '/images/option-2.jpg',
    alt: 'Option 2: Two-bedroom luxury waterfront apartment render',
    title: '2-Bedroom Waterfront Apartment',
    total: '₦79,000,000',
  },
];
---

<section class="offer" id="offer">
  <div class="container">
    <header class="offer__head">
      <p class="eyebrow tag">The offer</p>
      <h2 class="h2">Wait... you can start owning a home in Sangotedo with just ₦7 million?</h2>
      <p class="offer__lede">
        We know what you're thinking. It sounds almost too good to be true. But here's how the opportunity works.
        Capital Heights is currently offering attractive pre-launch prices for its waterfront apartments.
      </p>
    </header>

    <div class="cards">
      {
        options.map((o) => (
          <article class="opt">
            <div class="opt__media">
              <img src={o.img} width="512" height="225" loading="lazy" alt={o.alt} />
              <span class="opt__badge">{o.badge}</span>
            </div>
            <div class="opt__body">
              <h3 class="opt__title">{o.title}</h3>
              <p class="opt__total">
                <span>Total investment:</span>
                <strong>{o.total}</strong>
              </p>
              <div class="opt__deposit">
                <p class="eyebrow opt__label">Initial deposit</p>
                <p class="opt__amount">₦7,000,000</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="summary">
      <p class="summary__title">
        That's right. Whether you're interested in a 1-bedroom or 2-bedroom apartment, the initial deposit is ₦7
        million.
      </p>
      <p class="summary__body">
        You don't need to have the entire property price available before starting the conversation.
      </p>
      <p class="summary__kicker">This is your opportunity to explore waterfront property ownership in Sangotedo.</p>
      <a class="btn btn--lg btn--light summary__btn" href="#contact">Yes! I want to secure my interest</a>
    </div>
  </div>
</section>

<style>
  .offer {
    background: var(--bg);
    padding: 96px 0;
  }
  .offer__head {
    max-width: 768px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
  }
  .tag {
    margin-top: 1px;
    padding: 4px 8px;
    border-radius: 2px;
    background: var(--surface-2);
  }
  .offer__lede {
    max-width: 752px;
    padding-top: 8px;
    font: 400 18px/28px var(--sans);
    color: var(--muted);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px;
    margin-top: 64px;
  }
  .opt {
    overflow: hidden;
    border-radius: 16px;
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }
  .opt__media {
    position: relative;
    aspect-ratio: 2.27 / 1;
  }
  .opt__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .opt__badge {
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 4px 8px;
    border-radius: 2px;
    background: rgba(8, 15, 22, 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font: 700 10px/14px var(--sans);
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--muted);
  }
  .opt__body { padding: 40px; }
  .opt__title {
    max-width: 476px;
    font: 500 28px/36px var(--serif);
    text-transform: uppercase;
    color: var(--text);
  }
  .opt__total {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(80, 69, 53, 0.3);
  }
  .opt__total span {
    font: 600 12px/16px var(--sans);
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--muted);
  }
  .opt__total strong {
    font: 700 22px/30px var(--serif);
    color: var(--text);
  }
  .opt__deposit {
    margin-top: 16px;
    min-height: 96px;
    padding: 16px;
    border-radius: 8px;
    background: var(--surface-3);
    box-shadow: 0 0 35px rgba(229, 169, 60, 0.12);
  }
  .opt__label { color: var(--muted); }
  .opt__amount {
    font: 700 40px/48px var(--sans);
    letter-spacing: -0.8px;
    color: var(--gold);
  }

  .summary {
    max-width: 896px;
    margin: 64px auto 0;
    padding: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    border-radius: 16px;
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }
  .summary__title {
    max-width: 816px;
    font: 500 22px/30px var(--serif);
    color: var(--text);
  }
  .summary__body {
    max-width: 572px;
    margin-top: 16px;
    font: 400 14px/24px var(--sans);
    color: var(--muted);
  }
  .summary__kicker {
    margin-top: 16px;
    font: 700 12px/20px var(--sans);
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--gold);
  }
  .summary__btn {
    margin-top: 24px;
    padding: 16px 64px;
    box-shadow: 0 0 30px -5px rgba(255, 198, 101, 0.4);
  }

  @media (max-width: 900px) {
    .cards { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; gap: 24px; }
  }
  @media (max-width: 640px) {
    .offer { padding: 64px 0; }
    .cards { margin-top: 40px; }
    .opt__body { padding: 24px 20px; }
    .opt__title { font-size: 22px; line-height: 30px; }
    .opt__total strong { font-size: 19px; }
    .opt__label { color: var(--muted); }
  .opt__amount { font-size: 32px; line-height: 40px; }
    .summary { margin-top: 40px; padding: 28px 20px; }
    .offer__lede { font-size: 16px; line-height: 26px; }
    .summary__title { font-size: 19px; line-height: 27px; }
    .summary__btn { width: 100%; padding-inline: 16px; }
  }
</style>
